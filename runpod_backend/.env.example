PORT=8000

GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

HF_TOKEN=

DREAMO_QUANT=nunchaku
DREAMO_VERSION=v1.1
DREAMO_MEMORY_MODE=gpu
DREAMO_NO_TURBO=0

DREAMO_WIDTH=768
DREAMO_HEIGHT=768
DREAMO_REF_RES=512

SCORER_DEVICE=cpu

OGQ_STYLE_REFERENCE_MODE=canonical
OGQ_STYLE_REFERENCE=styles/reference.png
OGQ_FRAMING=upper_body

PROMPT_PLANNER_MODE=template

MAX_PENDING_JOBS=8

RUNPOD_DATA_DIR=/workspace/ogq-data
RUNPOD_LOCK_FILE=/workspace/ogq-data/server.lock

HF_HOME=/workspace/ogq-data/huggingface
TORCH_HOME=/workspace/ogq-data/torch
U2NET_HOME=/workspace/ogq-data/rembg

PROMPT_PLANNER_MODE=llm
PROMPT_LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1