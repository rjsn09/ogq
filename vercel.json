{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/canonical/:path*",
      "destination": "/api/canonical-proxy?path=:path*"
    },
    {
      "source": "/api/ogq",
      "destination": "/api/ogq.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
